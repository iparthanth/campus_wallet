# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/campus_wallet
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
PORT=3000

# Fraud thresholds (tunable per environment, not hardcoded in the rules)
FRAUD_VELOCITY_WINDOW_SEC=60
FRAUD_VELOCITY_MAX=3
FRAUD_THRESHOLD_MIN_PAISA=50000
FRAUD_THRESHOLD_MULT=5
