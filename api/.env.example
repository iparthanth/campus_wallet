# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# Development database. `npm test` automatically appends _test to this database name
# (see tests/setup-env.js) and refuses to run if the result is not a _test database,
# so your development data is never truncated by a test run.
# Create the test database once:  createdb campus_wallet_test
DATABASE_URL=postgres://wallet:wallet@localhost:5433/campus_wallet
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
PORT=3000

# bKash Tokenized Checkout (SANDBOX). Leave blank to disable top-up entirely —
# the app runs fine without it and /topup/available reports false.
# Get sandbox credentials from https://developer.bka.sh (the sandbox is open to all).
# Sandbox test values when paying: PIN 12121, OTP 123456.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:5173/topup/callback

# Fraud thresholds (tunable per environment, not hardcoded in the rules)
FRAUD_VELOCITY_WINDOW_SEC=60
FRAUD_VELOCITY_MAX=3
FRAUD_THRESHOLD_MIN_PAISA=50000
FRAUD_THRESHOLD_MULT=5
